{
  "name": "react-ts-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "build": "npm run build --workspaces --if-present",
    "frontend": "npm run dev -w frontend",
    "backend": "npm run dev -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
